{
  "name": "samudra-lex",
  "version": "1.0.0",
  "description": "Offline ICG maritime law enforcement decision-support desktop application",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron . --no-sandbox",
    "build": "electron-builder --dir",
    "package": "electron-builder",
    "database:init": "node src/main/database.js --init",
    "database:seed": "node src/main/database.js --seed",
    "test": "node scripts/check-db.js"
  },
  "keywords": [
    "electron",
    "maritime-law",
    "coast-guard",
    "sqlite",
    "decision-support"
  ],
  "author": "Samudra-Lex",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.samudra.lex",
    "productName": "SAMUDRA-LEX",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "database/**/*",
      "docs/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
